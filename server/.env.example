# Copie este arquivo para "server/.env" e ajuste se precisar.
PORT=3001

# MongoDB local (Docker ou instalado na máquina)
MONGO_URL=mongodb://localhost:27017
# MongoDB Atlas (nuvem) — exemplo:
# MONGO_URL=mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net
MONGO_DB=borapelada

# Segredo para assinar os tokens JWT (troque por um texto longo e aleatório)
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=7d

# Endereço do front-end em desenvolvimento (Vite)
WEB_ORIGIN=http://localhost:5173
